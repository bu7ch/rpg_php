{
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\\\Order\\\\": "Order/",
            "App\\\\Cart\\\\" : "Cart/",
            "App\\\\Model\\\\" : "Model/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\\\Tests\\\\": "Tests/"
        }
    },
    "scripts": {
        "test": "phpunit --bootstrap vendor/autoload.php tests/"
    }
}